rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'ADMIN' ||
         exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)));
    }

    function isComplianceOfficer() {
      return isAuthenticated() &&
        (request.auth.token.role == 'COMPLIANCE_OFFICER' ||
         request.auth.token.role == 'AUDITOR' ||
         isAdmin());
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'CUSTOMER';
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isKycVerified']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Campaigns Collection
    match /campaigns/{campaignId} {
      // Anyone can read active/approved/closed campaigns
      allow read: if resource.data.status in ['APPROVED', 'ACTIVE', 'PAUSED', 'CLOSED'] || isAdmin();
      // Only admins with compliance approval can write campaigns
      allow create, update: if isAdmin() &&
        request.resource.data.complianceApprovalNumber != null;
      allow delete: if false; // Soft-delete or archive only
    }

    // 3. Tickets Subcollection & Collection
    match /campaigns/{campaignId}/tickets/{ticketId} {
      // Public read of availability without exposing buyer phone or identity
      allow read: if true;
      // Atomic allocation only permitted via trusted Cloud Functions
      allow write: if false;
    }

    // 4. Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Client cannot directly mark booking as PAID; must be verified via Cloud Functions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                    request.resource.data.paymentStatus == 'PENDING';
      allow update, delete: if false;
    }

    // 5. Payments Collection (Strict Server-Side)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Cloud Functions webhook only
    }

    // 6. Draws & Results Collection
    match /draws/{drawId} {
      allow read: if resource.data.isPubliclyPublished == true || isComplianceOfficer();
      allow write: if isComplianceOfficer();
    }

    match /results/{resultId} {
      allow read: if true; // Public official audit record
      allow write: if isComplianceOfficer();
    }

    // 7. Admin Users Collection
    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable through Firebase CLI / IAM
    }

    // 8. Immutable Audit Logs (Append-Only)
    match /auditLogs/{logId} {
      allow read: if isComplianceOfficer();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strictly immutable
    }

    // 9. Legal Documents & Compliance Gates
    match /legalDocuments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isComplianceOfficer();
    }

    // 10. Consents Collection
    match /consents/{consentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isComplianceOfficer());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
